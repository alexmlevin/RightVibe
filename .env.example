# Server-side only - read in api/generate-haptics.ts, never sent to the client.
GEMINI_API_KEY=

# Vercel Blob (Project -> Storage -> Create Database -> Blob). Auto-populated on Vercel deploys.
BLOB_READ_WRITE_TOKEN=

# Redis for project/hotspot storage (Project -> Storage -> Create Database -> a Redis option from
# the Marketplace). Auto-populated on Vercel deploys as either of these two pairs - api/_lib/redis.ts
# accepts either naming, only one pair is required.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
